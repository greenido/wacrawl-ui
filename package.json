{
  "name": "wacrawl-dashboard",
  "version": "0.1.2",
  "description": "Local WhatsApp analytics dashboard powered by a WaCrawl SQLite archive",
  "keywords": [
    "whatsapp",
    "analytics",
    "dashboard",
    "wacrawl",
    "sqlite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenido/wacrawl-ui.git"
  },
  "homepage": "https://github.com/greenido/wacrawl-ui#readme",
  "bugs": {
    "url": "https://github.com/greenido/wacrawl-ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "wacrawl-dashboard": "bin/wacrawl-dashboard.js"
  },
  "files": [
    "apps/api/dist",
    "apps/api/package.json",
    "apps/web/dist",
    "bin"
  ],
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @wacrawl/api\" \"npm run dev -w @wacrawl/web\"",
    "build": "npm run build -w @wacrawl/api && npm run build -w @wacrawl/web",
    "test": "npm run test -w @wacrawl/api",
    "preview": "npm run preview -w @wacrawl/web",
    "typecheck": "npm run typecheck -w @wacrawl/api && npm run typecheck -w @wacrawl/web && tsc -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "npm run lint && npm run typecheck && npm test",
    "verify:full": "npm run verify && npm run build && npm run test:e2e && npm run test:fresh-install",
    "demo": "node bin/wacrawl-dashboard.js --demo",
    "test:e2e": "playwright test --project=smoke",
    "test:fresh-install": "node e2e/fresh-install.mjs",
    "docs:screenshots": "playwright test --project=screenshots",
    "prepublishOnly": "npm run verify && npm run build",
    "publish:verify-auth": "npm whoami",
    "publish:npm": "npm run publish:verify-auth && npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "stopword": "^3.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
